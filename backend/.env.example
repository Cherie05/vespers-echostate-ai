# EchoState AI - Backend Environment Configuration Template
# Copy this file to .env for local development or set these variables in the Railway dashboard.
# DO NOT commit .env containing real keys to version control.

# Server Settings
ENV=production
DEBUG=false
ALLOWED_ORIGINS=*

# Google DeepMind / Gen AI API Keys
# Access to Gemini 3.8 Flash, Gemini 3.8 Live, Gemini 3.8 Flash TTS, Gemini 3.5 Transcribe/Translate
GEMINI_API_KEY=your_gemini_api_key_here

# Antigravity Managed Agent Interactions API (preview-09-2026)
ANTIGRAVITY_API_KEY=your_antigravity_api_key_here
ANTIGRAVITY_ENDPOINT=https://api.antigravity.google/v1alpha

# Model Identifier Mappings (Google Hackathon Stack)
MODEL_VISION_FLASH=gemini-3.8-flash
MODEL_AUDIO_LIVE=gemini-3.8-live
MODEL_AUDIO_TTS=gemini-3.8-flash-tts
MODEL_AUDIO_TRANSCRIBE=gemini-3.5-transcribe
MODEL_AUDIO_TRANSLATE=gemini-3.5-live-translate-preview
MODEL_AGENT_ORCHESTRATOR=antigravity-preview-09-2026
