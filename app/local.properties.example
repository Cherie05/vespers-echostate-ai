# EchoState AI - Android Local Properties Template
# Copy this file to local.properties and set your local environment variables.
# Do NOT commit local.properties to git.

# Backend Service URL (for local emulator use 10.0.2.2, for physical device use your local IP, or Railway URL)
BACKEND_BASE_URL=http://10.0.2.2:8000
BACKEND_WS_URL=ws://10.0.2.2:8000

# Direct API Keys (Optional fallback if not using backend proxy)
GOOGLE_GEN_AI_KEY=your_gemini_api_key_here
ANTIGRAVITY_API_KEY=your_antigravity_key_here
